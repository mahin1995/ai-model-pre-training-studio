# scripts/dev.py creates .env with a random local PostgreSQL password.
POSTGRES_USER=studio
POSTGRES_DB=pretraining_studio
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432
# Set a PostgreSQL URL to use an existing database and skip managed Docker startup.
# DATABASE_URL=postgresql://user:password@host:5432/database
API_PORT=8000
FRONTEND_PORT=5173
# Disk checks inspect this directory on the backend host. Default: repository root.
# STUDIO_DATA_DIR=/path/to/training/data
