# scripts/dev.py creates .env with a random local PostgreSQL password.
POSTGRES_USER=studio
POSTGRES_DB=pretraining_studio
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432
# Set a PostgreSQL URL to use an existing database and skip managed Docker startup.
# DATABASE_URL=postgresql://user:password@host:5432/database
API_PORT=8000
FRONTEND_PORT=5173
# Disk checks inspect this directory on the backend host. Default: repository root.
# STUDIO_DATA_DIR=/path/to/training/data
# Dataset uploads/artifacts live under <STUDIO_DATA_DIR>/datasets.
# Default dataset storage root: <repository>/data. Keep it with PostgreSQL backups.
# Optional server-controlled training interpreter. Defaults to .venv-training/bin/python.
# Create it explicitly with python3 scripts/setup_training.py --profile cpu (or cu128).
# STUDIO_TRAINING_PYTHON=/absolute/path/to/.venv-training/bin/python
